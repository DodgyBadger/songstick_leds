#!/usr/bin/env bash
set -euo pipefail

readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly WASM_GENERATED_DIR="${REPO_ROOT}/web/src/generated"

"${REPO_ROOT}/scripts/build-wasm"
mkdir -p "${WASM_GENERATED_DIR}"
cp "${REPO_ROOT}/build/wasm/songstick.js" "${WASM_GENERATED_DIR}/songstick.js"
cp "${REPO_ROOT}/build/wasm/songstick.wasm" "${WASM_GENERATED_DIR}/songstick.wasm"
