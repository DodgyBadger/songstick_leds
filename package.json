{
  "name": "songstick-leds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:wasm": "./scripts/build-wasm",
    "prepare:web": "./scripts/prepare-web",
    "dev": "npm run prepare:web && vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare:web && npm run typecheck && vite build --config vite.config.ts",
    "test:web": "node --test tests/web/midi-upload.test.ts tests/web/instrument-interface.test.ts && node tests/web/led-strip.test.ts",
    "test": "./scripts/test-native && ./scripts/test-wasm && npm run test:web"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "dependencies": {
    "lucide": "1.39.0"
  }
}
